# markting-ai — local stack configuration. Copy to .env (gitignored). Never commit real values.
# `make env` fills the random secrets; `make supabase-start` fills the Supabase keys from `supabase status`.

# ── adport cloud (Supabase on the host via `supabase start`, ports 553xx) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=from_supabase_status
SUPABASE_SECRET_KEY=from_supabase_status
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres
ADPORT_DB_ROLE=adport_backend
ADPORT_CLOUD_BASE_URL=http://localhost:3000
# generated by `make env`
ADPORT_CLOUD_ENCRYPTION_KEY=generate_me
ADPORT_API_KEY_PEPPER=generate_me
ADPORT_MCP_OAUTH_SIGNING_KEY=generate_me
# Leave provider OAuth app blocks empty for the demo (see platform/apps/cloud/.env.example for the full list).
# Do NOT set ADPORT_PROVIDER_TEST_ORGANIZATION_IDS to an empty string: that denies every organization.

# ── markting-ai bridge (cloud → engine, server-side only) ──────────────────────────────────────
# generated by `make env`; the engine receives it as PAID_MEDIA_API_TOKENS=<token>:adport-bridge
MARKTING_ENGINE_TOKEN=generate_me
# true = sandbox provider mirroring the engine fixtures; previews still go through the policy engine.
MARKTING_DEMO_MODE=true
# Single-user demos may apply their own previews. Keep false with a real team.
MARKTING_ALLOW_SELF_APPROVAL=true
# demo = scripted offline model, no key needed. live = real model via PAID_MEDIA_MODEL below.
MARKTING_ENGINE_MODE=demo

# ── paid-media-agent engine (only read in MARKTING_ENGINE_MODE=live) ───────────────────────────
# PAID_MEDIA_MODEL=anthropic:claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Pin the synthetic data's last complete day for reproducible demos (default: today - 2).
# PAID_MEDIA_FIXTURE_ANCHOR=2026-08-28

# ── demo seed (make seed) ──────────────────────────────────────────────────────────────────────
MARKTING_DEMO_EMAIL=demo@markting.local
MARKTING_DEMO_PASSWORD=generate_me
