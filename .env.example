# markting-ai — local stack configuration. Copy to .env (gitignored). Never commit real values.
# `make env` fills the random secrets; `make supabase-start` fills the Supabase keys from `supabase status`.

# ── adport cloud (Supabase on the host via `supabase start`, ports 553xx) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=from_supabase_status
SUPABASE_SECRET_KEY=from_supabase_status
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres
ADPORT_DB_ROLE=adport_backend
ADPORT_CLOUD_BASE_URL=http://localhost:3000
# generated by `make env`
ADPORT_CLOUD_ENCRYPTION_KEY=generate_me
ADPORT_API_KEY_PEPPER=generate_me
ADPORT_MCP_OAUTH_SIGNING_KEY=generate_me
# Leave provider OAuth app blocks empty for the demo (see platform/apps/cloud/.env.example for the full list).
# Do NOT set ADPORT_PROVIDER_TEST_ORGANIZATION_IDS to an empty string: that denies every organization.

# ── Snapchat (Phase 3). The provider package ships with adport; these switches enable it in the cloud app.
# Create an OAuth app in Snap Business Manager → Business Details → OAuth Apps and register
#   ${ADPORT_CLOUD_BASE_URL}/api/oauth/snapchat/callback  as the redirect URI.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# true shows the Snapchat card in Connections once the two values above are set.
SNAPCHAT_OAUTH_ENABLED=false
# Leave ADPORT_PROVIDER_TEST_ORGANIZATION_IDS UNSET to allow every organization while your Snap app is in
# development; an EMPTY string denies all organizations; a comma-separated list limits testing to those org ids.
# ADPORT_PROVIDER_TEST_ORGANIZATION_IDS=

# ── Billing (Stripe, optional). Without these the Plan page shows plans as "coming soon" and the demo
# seed grants the operator plan directly in the database.
#   1. Stripe Dashboard → Developers → API keys: a TEST secret key.
#   2. node infra/scripts/stripe-setup.mjs --write .env   (creates products/prices once, fills the ids below)
#   3. make stripe-listen   (Stripe CLI forwards test webhooks to the cloud app and prints the whsec_ secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_OPERATOR_PRICE_ID=
STRIPE_OPERATOR_ANNUAL_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=

# ── markting-ai bridge (cloud → engine, server-side only) ──────────────────────────────────────
# generated by `make env`; the engine receives it as PAID_MEDIA_API_TOKENS=<token>:adport-bridge
MARKTING_ENGINE_TOKEN=generate_me
# true = sandbox provider mirroring the engine fixtures; previews still go through the policy engine.
MARKTING_DEMO_MODE=true
# Requester==approver (four-eyes) exception. Default OFF (production-safe). A single-user demo may
# set this to true explicitly; a real team must leave it false. Note: engine proposals are requested
# by the ai_agent, so a human approving them is never self-approval regardless of this flag.
MARKTING_ALLOW_SELF_APPROVAL=false
# demo = scripted offline model, no key needed. live = real model via PAID_MEDIA_MODEL below.
MARKTING_ENGINE_MODE=demo

# ── paid-media-agent engine (only read in MARKTING_ENGINE_MODE=live) ───────────────────────────
# PAID_MEDIA_MODEL=anthropic:claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Pin the synthetic data's last complete day for reproducible demos (default: today - 2).
# PAID_MEDIA_FIXTURE_ANCHOR=2026-08-28

# ── demo seed (make seed) ──────────────────────────────────────────────────────────────────────
MARKTING_DEMO_EMAIL=demo@markting.local
MARKTING_DEMO_PASSWORD=generate_me
